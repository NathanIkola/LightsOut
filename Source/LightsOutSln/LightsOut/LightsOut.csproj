<Project Sdk="Microsoft.NET.Sdk">

	<!-- General project configuration -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>

		<RootNamespace>LightsOut</RootNamespace>
		<AssemblyName>LightsOut</AssemblyName>

		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<Deterministic>true</Deterministic>

		<!-- Preserve the original assembly output directory -->
		<OutputPath>..\..\..\Assemblies\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

		<!-- Avoid generating an unnecessary .deps.json file -->
		<GenerateDependencyFile>false</GenerateDependencyFile>

		<!-- Generate assembly metadata using SDK-style MSBuild -->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<!-- Automatic date/time assembly versioning -->
	<PropertyGroup>
		<BuildTimestamp>$([System.DateTime]::Now.ToString('yyyy.MM.dd.HHmm'))</BuildTimestamp>

		<AssemblyVersion>$(BuildTimestamp)</AssemblyVersion>
		<FileVersion>$(AssemblyVersion)</FileVersion>
		<InformationalVersion>$(AssemblyVersion)</InformationalVersion>

		<!-- Static NuGet-style project version -->
		<Version>1.0.0</Version>
	</PropertyGroup>

	<!-- Debug configuration -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
		<WarningLevel>4</WarningLevel>
	</PropertyGroup>

	<!-- Release configuration -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>true</Optimize>
		<DefineConstants>$(DefineConstants);TRACE</DefineConstants>
		<WarningLevel>4</WarningLevel>
	</PropertyGroup>

	<!-- RimWorld paths -->
	<PropertyGroup>
		<RimWorldDir Condition="'$(RimWorldDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldDir>
		<RimWorldModDir>$(RimWorldDir)\Mods\LightsOut</RimWorldModDir>

		<ModRoot>$(MSBuildProjectDirectory)\..\..\..</ModRoot>
	</PropertyGroup>

	<!-- RimWorld references -->
	<ItemGroup>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="UnityStubs">
			<HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="Waylith">
			<HintPath>$(RimWorldDir)\Waylith.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- NuGet dependencies -->
	<ItemGroup>
		<PackageReference Include="Lib.Harmony" Version="2.3.6" />
	</ItemGroup>

	<!-- Source files are included automatically by the SDK.
       Exclude the legacy AssemblyInfo.cs to prevent duplicate
       assembly attributes. -->
	<ItemGroup>
		<Compile Remove="Properties\AssemblyInfo.cs" />
	</ItemGroup>

	<!-- Deploy mod files after a successful build -->
	<Target Name="DeployToRimWorld"
			AfterTargets="Build"
			Condition="'$(OS)' == 'Windows_NT'">

		<!-- Existing RimWorld content directories -->
		<ItemGroup>
			<ModFolders Include="About" />
			<ModFolders Include="Defs" />
			<ModFolders Include="Languages" />
			<ModFolders Include="Patches" />
			<ModFolders Include="Sounds" />
			<ModFolders Include="Textures" />
			<ModFolders Include="1.3" />
			<ModFolders Include="1.4" />
			<ModFolders Include="1.5" />
		</ItemGroup>

		<!-- Copy each content directory -->
		<Exec
		  Command='xcopy "$(ModRoot)\%(ModFolders.Identity)" "$(RimWorldModDir)\%(ModFolders.Identity)" /Y/E/H/C/I'
		  Condition="Exists('$(ModRoot)\%(ModFolders.Identity)')" />

		<!-- Copy loadFolders.xml -->
		<Copy
		  SourceFiles="$(ModRoot)\loadFolders.xml"
		  DestinationFiles="$(RimWorldModDir)\loadFolders.xml"
		  Condition="Exists('$(ModRoot)\loadFolders.xml')"
		  SkipUnchangedFiles="true" />

		<!-- Deploy LightsOut.dll -->
		<Copy
		  SourceFiles="$(TargetPath)"
		  DestinationFolder="$(RimWorldModDir)\Assemblies\"
		  SkipUnchangedFiles="true" />

		<!-- Deploy Harmony if present in the build output -->
		<Copy
		  SourceFiles="$(TargetDir)0Harmony.dll"
		  DestinationFolder="$(RimWorldModDir)\Assemblies\"
		  Condition="Exists('$(TargetDir)0Harmony.dll')"
		  SkipUnchangedFiles="true" />

		<!-- Preserve the existing DocFX site deployment -->
		<Exec
		  Command='xcopy "$(MSBuildProjectDirectory)\_site" "$(ModRoot)\docs" /Y/E/H/C/I'
		  Condition="Exists('$(MSBuildProjectDirectory)\_site')" />

	</Target>

</Project>